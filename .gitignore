# ============================================================
# PMEGP DPR Pro — .gitignore
# Electron.js + React + Vite + Windows .exe App
# ============================================================


# ─────────────────────────────────────────
# NODE / NPM / YARN / PNPM
# ─────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml
.npmrc


# ─────────────────────────────────────────
# PYTHON VIRTUAL ENVIRONMENT
# ─────────────────────────────────────────
/Scripts/
/Lib/
site-packages/
**/site-packages/
include/
pyvenv.cfg
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-selfcheck.json


# ─────────────────────────────────────────
# BUILD OUTPUT
# ─────────────────────────────────────────
dist/
dist-electron/
out/
build/
release/
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.pkg
*.appx


# ─────────────────────────────────────────
# VITE / REACT BUILD
# ─────────────────────────────────────────
dist/
.vite/
vite.config.js.timestamp-*


# ─────────────────────────────────────────
# ELECTRON BUILDER CACHE
# ─────────────────────────────────────────
.electron-builder-cache/
electron-builder.env


# ─────────────────────────────────────────
# AI / API KEYS — NEVER COMMIT THESE!
# ─────────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.test
.env.*
secrets.json
config.secret.json
api-keys.json


# ─────────────────────────────────────────
# APP USER DATA (electron-store / sqlite)
# ─────────────────────────────────────────
userData/
appData/
*.dpr
settings.json
projects/
exports/
*.sqlite
*.sqlite3
*.db


# ─────────────────────────────────────────
# LOGS
# ─────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
electron-*.log
crash-reports/


# ─────────────────────────────────────────
# OS GENERATED FILES
# ─────────────────────────────────────────

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ─────────────────────────────────────────
# IDE / EDITOR FILES
# ─────────────────────────────────────────

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (IntelliJ, WebStorm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Neovim
*.swp
*.swo
*.swn
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock


# ─────────────────────────────────────────
# TYPESCRIPT
# ─────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo


# ─────────────────────────────────────────
